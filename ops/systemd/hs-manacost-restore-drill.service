[Unit]
Description=HS Manacost database and S3 restore drill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/hs-manacost/backup.env
WorkingDirectory=/usr/local/libexec/hs-manacost-backup
ExecStart=/usr/local/libexec/hs-manacost-backup/restore-drill.sh
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
TimeoutStartSec=8h
