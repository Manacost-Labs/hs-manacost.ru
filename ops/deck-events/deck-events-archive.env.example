# /etc/hs-manacost/deck-events-archive.env (root:root 600). No secrets here:
# S3 keys and crypt passwords live in the files these paths name.
DECK_ARCHIVE_DATABASE=hsmanaco_sep1616
DECK_ARCHIVE_TABLE_PREFIX=wp_ksoo_
DECK_ARCHIVE_ENVIRONMENT=production
DECK_ARCHIVE_S3_BUCKET=hs-manacost-backups-3az
# Must stay outside every prefix another job prunes (checked on every run).
DECK_ARCHIVE_S3_PREFIX=deck-events
DECK_ARCHIVE_PROTECTED_PREFIXES=hs-data-platform
DECK_ARCHIVE_S3_CREDENTIALS_FILE=/home/debian/.config/hs-manacost/object-storage-media.json
DECK_ARCHIVE_CRYPT_ENV=/home/debian/server/secrets/deck-events-archive/crypt.env
