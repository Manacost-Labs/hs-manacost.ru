# Root-owned file location: /etc/hs-manacost/backup.env (mode 0600).
# Values below are examples only. Never commit real passwords or credentials.
HS_RESTIC_REPOSITORY=/path/to/existing/encrypted/restic/repository
HS_RESTIC_PASSWORD_FILE=/root/.config/restic/hs-manacost-password
HS_DB_BACKUP_GLOB=*/wordpress_database.sql.gz
HS_DB_RESTORE_DATABASE=wordpress_database
HS_DB_TABLE_PREFIX=wp_
HS_RESTIC_SNAPSHOT_TAG=core
HS_S3_SOURCE_REMOTE=hssource:hs-manacost-media-3az/wp-content
HS_S3_BACKUP_REMOTE=hsbackup:hs-manacost-backups-3az/site-media
HS_S3_CREDENTIALS_FILE=/path/to/existing/private/source-credentials.json
HS_S3_BACKUP_CREDENTIALS_FILE=/path/to/existing/private/backup-credentials.json
HS_RESTIC_CREDENTIALS_FILE=/path/to/existing/private/restic-credentials.json
HS_S3_RESTORE_SAMPLE=uploads/2026/09/oblozhka.png
HS_S3_APPLY_RETENTION=0
HS_S3_RETENTION_DAYS=90
