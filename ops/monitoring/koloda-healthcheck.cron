SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
1-4,6-9,11-14,16-19,21-24,26-29,31-34,36-39,41-44,46-49,51-54,56-59 * * * * root /usr/local/libexec/manacost-monitoring/run-healthcheck.sh koloda quick >/dev/null 2>&1
*/5 * * * * root /usr/local/libexec/manacost-monitoring/run-healthcheck.sh koloda full >/dev/null 2>&1
