{
  "version": 1,
  "stack": "wordpress",
  "project": "hs-manacost.ru",
  "design": {
    "tokens": {
      "from_css": [
        "wordpress/mu-plugins/hs-manacost-reader/ui.css",
        "wordpress/mu-plugins/hs-manacost-reader/reader.css"
      ]
    },
    "token_sources": [
      "wordpress/mu-plugins/hs-manacost-reader/ui.css"
    ],
    "token_selectors": [
      ".mc-reader-ui"
    ],
    "registry": [
      {
        "name": "ReaderButton",
        "source": "wordpress/mu-plugins/hs-manacost-reader/ui.css",
        "tokens": [
          "--mc-ui-accent",
          "--mc-ui-radius"
        ],
        "states": [
          "default",
          "secondary",
          "disabled",
          "focus"
        ],
        "keywords": [
          "кнопка",
          "нажатие",
          "действие"
        ]
      },
      {
        "name": "ReaderAccount",
        "source": "wordpress/mu-plugins/hs-manacost-reader/account.php",
        "tokens": [
          "--mc-ui-surface",
          "--mc-ui-text"
        ],
        "states": [
          "overview",
          "editing"
        ],
        "keywords": [
          "аккаунт",
          "вход",
          "профиль",
          "подписка"
        ]
      },
      {
        "name": "ReaderComments",
        "source": "wordpress/mu-plugins/hs-manacost-reader/comments.php",
        "tokens": [
          "--mc-ui-text"
        ],
        "states": [
          "guest",
          "signed-in"
        ],
        "keywords": [
          "комментарии",
          "обсуждение",
          "ответ"
        ]
      },
      {
        "name": "PlatformIcons",
        "source": "wordpress/mu-plugins/hs-manacost-reader/platform-icons.php",
        "tokens": [],
        "states": [
          "platform"
        ],
        "keywords": [
          "иконки",
          "социальные сети",
          "платформа"
        ]
      },
      {
        "name": "AdminUiPatterns",
        "source": "wordpress/mu-plugins/hs-admin-ui-patterns/class-hs-admin-ui-patterns.php",
        "keywords": [
          "админка",
          "таблица",
          "форма",
          "диалог",
          "фокус",
          "кнопка",
          "удаление"
        ],
        "screenshots": [
          "tests/visual/wordpress.spec.ts-snapshots/admin-ui-patterns-desktop-1440-linux.png",
          "tests/visual/wordpress.spec.ts-snapshots/admin-ui-patterns-mobile-390-linux.png"
        ],
        "screenshot_sources": {
          "wordpress/mu-plugins/hs-admin-ui-patterns/class-hs-admin-ui-patterns.php": "f934c03ddbd923c5b3c15d36d456199c51c737bbeb7335bf3bad1571734e81cc",
          "wordpress/mu-plugins/hs-admin-ui-patterns/patterns.css": "cc8de77c2e4a025645caf6d12687a4bfd11ca3b5f1217eddebe0c4efe8e92632"
        },
        "screenshot_scope": "Native disposable WordPress pattern-library page, desktop and mobile; keyboard/dialog assertions accompany these references."
      }
    ]
  },
  "checks": [
    {
      "id": "php-syntax",
      "argv": [
        "make",
        "php-lint"
      ],
      "tier": "fast",
      "paths": [
        "wordpress/**/*.php",
        "config/**/*.php"
      ],
      "timeout": 300
    },
    {
      "id": "contracts",
      "argv": [
        "make",
        "contract-check"
      ],
      "tier": "fast",
      "paths": []
    },
    {
      "id": "unit",
      "argv": [
        "make",
        "test"
      ],
      "tier": "fast",
      "paths": []
    },
    {
      "id": "first-party-code-quality",
      "argv": [
        "make",
        "code-quality"
      ],
      "tier": "medium",
      "paths": [],
      "timeout": 300
    },
    {
      "id": "reader-css",
      "argv": [
        "make",
        "reader-css-check"
      ],
      "tier": "medium",
      "paths": [
        "wordpress/mu-plugins/hs-manacost-reader/**"
      ]
    },
    {
      "id": "reader-tests",
      "argv": [
        "make",
        "reader-test"
      ],
      "tier": "medium",
      "paths": [
        "wordpress/mu-plugins/hs-manacost-reader/**",
        "services/reader/**"
      ]
    },
    {
      "id": "integration",
      "argv": [
        "make",
        "integration"
      ],
      "tier": "heavy",
      "paths": [],
      "timeout": 600,
      "network": true
    },
    {
      "id": "visual",
      "argv": [
        "make",
        "visual"
      ],
      "tier": "heavy",
      "paths": [],
      "family": "design",
      "timeout": 600,
      "network": true
    },
    {
      "id": "design-tokens",
      "argv": [
        "{python}",
        "{quality_root}/design_guard.py",
        "--config",
        "config/quality-guard.json",
        "tokens"
      ],
      "tier": "fast",
      "paths": [],
      "family": "design"
    },
    {
      "id": "design-components",
      "argv": [
        "{python}",
        "{quality_root}/design_guard.py",
        "--config",
        "config/quality-guard.json",
        "components"
      ],
      "tier": "fast",
      "paths": [],
      "family": "design"
    },
    {
      "id": "dependency-audit",
      "argv": [
        "make",
        "quality-audit"
      ],
      "tier": "medium",
      "network": true,
      "timeout": 120
    },
    {
      "id": "mutation",
      "argv": [
        "make",
        "quality-mutation"
      ],
      "tier": "heavy",
      "timeout": 600
    },
    {
      "id": "wpscan",
      "argv": [
        "make",
        "quality-wpscan"
      ],
      "tier": "heavy",
      "network": true,
      "timeout": 600
    },
    {
      "id": "query-monitor",
      "argv": [
        "make",
        "quality-query-monitor"
      ],
      "tier": "heavy",
      "network": true,
      "timeout": 600
    },
    {
      "id": "public-advisories",
      "argv": [
        "make",
        "quality-advisories"
      ],
      "tier": "heavy",
      "network": true,
      "timeout": 600
    }
  ],
  "heavy_limits": {
    "cpu_percent": 200,
    "memory_mb": 2048
  }
}
