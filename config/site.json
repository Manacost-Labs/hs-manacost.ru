{
  "site": {
    "name": "Manacost",
    "primary_url": "https://hs-manacost.ru",
    "mirror_url": "https://hs-manacost.com",
    "staging_url": "https://test.hs-manacost.ru",
    "timezone": "Europe/Moscow",
    "permalink_structure": "/%postname%/"
  },
  "runtime": {
    "wordpress": "6.9.7",
    "nginx": "1.30.1",
    "php_fpm": "8.4",
    "php_cli_at_snapshot": "8.2.33",
    "mariadb": "10.11.18",
    "theme": "Newspaper_new",
    "theme_version": "12.7.3"
  },
  "paths": {
    "source": "/srv/projects/wordpress/hs-manacost.ru",
    "staging": "/var/www/koloda/data/www/test-hs-manacost-wordpress",
    "production": "/var/www/koloda/data/www/hs-manacost.ru"
  },
  "data_policy": {
    "database_in_git": false,
    "uploads_in_git": false,
    "secrets_in_git": false,
    "runtime_cache_in_git": false,
    "production_and_mirror_share_runtime": true,
    "staging_uses_isolated_database": true
  }
}
