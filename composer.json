{
  "name": "manacost/hs-manacost-quality",
  "description": "Development-only quality tooling for first-party hs-manacost.ru WordPress code.",
  "type": "project",
  "license": "proprietary",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
    "deptrac/deptrac": "^4.7",
    "infection/infection": "^0.29",
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "phpunit/phpunit": "^11.0",
    "rector/rector": "^2.0",
    "szepeviktor/phpstan-wordpress": "2.0.3",
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "infection/extension-installer": false
    },
    "sort-packages": true
  },
  "scripts": {
    "quality:phpcs": "phpcs --standard=phpcs.xml.dist",
    "quality:compat": "phpcs --standard=phpcompat.xml.dist",
    "quality:phpstan": "phpstan analyse --configuration=phpstan.neon.dist --no-progress"
  }
}
